# Mock origin
ORIGIN_URL=http://localhost:8080
ORIGIN_PORT=8080

# EdgeCache
CACHE_URL=http://localhost:3000

# Cache cold
COLD_VUS=20
COLD_ITERATIONS=1000

# Cache warm
WARM_VUS=30
WARM_RPS=300
WARM_DURATION=60s
WARM_START_TIME=15s
WARM_POOL_SIZE=200

# Baseline / Hot key (origin + cache)
HOT_VUS=50
HOT_RPS=500
HOT_DURATION=60s
HOT_FILE_ID=1mb-hot-0

# Degradation (breakpoint)
DEGRADE_FILE_ID=1mb-degrade-0
DEGRADE_START_RPS=50
DEGRADE_STEP_RPS=100
DEGRADE_STEPS=20
DEGRADE_STAGE_SEC=30
DEGRADE_PRE_VUS=200
DEGRADE_MAX_VUS=4000
DEGRADE_P99_LIMIT=1000
DEGRADE_ERR_LIMIT=0.01
DEGRADE_ABORT_DELAY=10s
